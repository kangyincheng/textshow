{
  "name": "textshow",
  "version": "1.0.0",
  "description": "TEXTSHOW 手机荧光字牌：演唱会应援、车辆故障警示",
  "main": "index.html",
  "scripts": {
    "android:init": "npx cap add android && npx cap sync android",
